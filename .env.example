# Backend Environment Variables

# Firebase Configuration
# Path to your Firebase service account key JSON file
# Download from Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./tonequest_backend/app/ServiceAccountKey.json

# Firestore Database ID (optional, uses default if not set)
# FIRESTORE_DATABASE_ID=(default)

# Redis Configuration (optional, uses fakeredis if not set)
# REDIS_URL=redis://localhost:6379

# Collection Names (optional, uses defaults if not set)
# QUESTIONS_COLLECTION=QnA
# SUBMISSIONS_COLLECTION=submissions
# LEADERBOARD_COLLECTION=leaderboard
