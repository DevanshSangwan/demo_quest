rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - only user can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // QnA collection - authenticated users can read
    match /QnA/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Leaderboard collection - authenticated users can read
    match /leaderboard/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // Scores collection - users can read/write their own scores
    match /scores/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
